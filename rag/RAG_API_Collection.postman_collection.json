{
  "info": {
    "name": "RAG System API",
    "description": "Research Paper RAG System API with URL-based upload support. Configure {{base_url}} variable (default: http://localhost:8000)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Paper Management",
      "item": [
        {
          "name": "Upload Papers from File",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/papers/upload",
              "host": ["{{base_url}}"],
              "path": ["api", "papers", "upload"]
            }
          }
        },
        {
          "name": "Upload Papers from URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"urls\": [\n    \"https://pub-f4b2cb5b350e44308eb23c8c7ef20596.r2.dev/materials/theory/ba14402c-1537-4ca5-81a2-80de53e6f664/NYunD8NLQSqTfAQEO6UBr.pdf\"\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/papers/upload",
              "host": ["{{base_url}}"],
              "path": ["api", "papers", "upload"]
            }
          }
        },
        {
          "name": "List All Papers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/papers",
              "host": ["{{base_url}}"],
              "path": ["api", "papers"]
            }
          }
        },
        {
          "name": "Get Paper by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/papers/1",
              "host": ["{{base_url}}"],
              "path": ["api", "papers", "1"]
            }
          }
        },
        {
          "name": "Get Paper Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/papers/1/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "papers", "1", "stats"]
            }
          }
        },
        {
          "name": "Delete Paper",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/papers/1",
              "host": ["{{base_url}}"],
              "path": ["api", "papers", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Query System",
      "item": [
        {
          "name": "Query Papers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is blockchain sustainability?\",\n  \"top_k\": 5,\n  \"model\": \"llama3\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/query",
              "host": ["{{base_url}}"],
              "path": ["api", "query"]
            }
          }
        },
        {
          "name": "Query Specific Papers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What methodology was used?\",\n  \"top_k\": 5,\n  \"paper_ids\": [1, 2],\n  \"model\": \"llama3\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/query",
              "host": ["{{base_url}}"],
              "path": ["api", "query"]
            }
          }
        },
        {
          "name": "Query with Streaming (SSE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is blockchain sustainability?\",\n  \"top_k\": 5,\n  \"model\": \"llama3\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/query/stream",
              "host": ["{{base_url}}"],
              "path": ["api", "query", "stream"]
            }
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Query History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/queries/history?limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "queries", "history"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Popular Topics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/analytics/popular?limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "analytics", "popular"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Root Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            }
          }
        },
        {
          "name": "Detailed Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        }
      ]
    }
  ]
}
