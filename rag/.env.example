# RAG Service Environment Variables
# Copy this file to .env and customize as needed

# Database Configuration
DATABASE_URL=postgresql+psycopg2://rag_user:rag_pass@postgres:5432/ragdb

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=research_papers

# Ollama LLM Configuration
# Use host.docker.internal for Docker Desktop (Mac/Windows)
# Use your actual host IP for Linux (e.g., 192.168.1.100)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Re-ranking Configuration
RERANK_RETRIEVAL_MULTIPLIER=2

# Hugging Face Cache
HF_HOME=/cache
TRANSFORMERS_CACHE=/cache/transformers

# API Configuration
UVICORN_RELOAD=true
PYTHONUNBUFFERED=1
